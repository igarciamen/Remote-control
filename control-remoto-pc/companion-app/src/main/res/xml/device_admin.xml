<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal Device Admin policy — just enough to make the app protected
     from accidental uninstall (has to be deactivated in Settings first). -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>